import random
from pprint import pprint #Подключили библеотеку pprint, чтобы в дальнейшем работать с ней.

i = 0
mass = [] #Массив для чиселок.
while True: #Бесконечный цикл, будет работать, пока его не остановят командой break.
    random_chislo = random.randint(0, 10000) #Случайное число, сгенерированное в заданном диапазоне.
    mass.append(random_chislo) #Добавляем в массив случайное сгенерированное число в массив.
    if random_chislo == 0: #Когда алгоритм нашел 0, он прекращает работу функцией break.
        break

pprint(mass,width=4) #Параметр width отвечает за максимальную длину выводимой на экран строки.
print(len(mass) - 1) #Количество всех чисел, не включая 0.

print('выбери операцию, которую я выполню: \n '
      '1.Найти сумму введённых чисел. \n '
      '2.Найти произведение введённых чисел. \n '
      '3.Найти среднее значение введённых чисел. \n '
      '4.Найти максимальное из введённых чисел. \n '
      '5.Найти минимальное из введённых чисел.\n '
      '6.Найти количество чётных и нечётных элементов.')
# \n  -  это перенос строки.

number_of_operation = int(input()) #Считываем номер операции.

if number_of_operation == 1:
    print(sum(mass))

if number_of_operation == 2:
    proizvedenie = 1
    for j in range(len(mass)-1):  #Проходимся по массиву с числами. Почему range(len(mass) - 1)? Все просто, мы исключили ноль, который обнулит нам все произведение.
        proizvedenie *= mass[j]
        print(proizvedenie)
        
if number_of_operation == 3:
    sr_znach = sum(mass) / (len(mass)-1)
    print(sr_znach)

if number_of_operation == 4:
    print(max(mass))

if number_of_operation == 5: #Так как в любом случае минимальным числом будет 0, найдем число, которое >0, но меньше остальных
    mass.pop() #Функция pop() удаляет последний элемент заданного массива, в нашем случае мы удалили ненужный ноль))
    print(min(mass))

if number_of_operation == 6:
    chet = 0 #Завели переменную, которая будет пересчитывать кол-во чётных чисел
    nechet = 0 #Завели переменную, которая будет пересчитывать кол-во нечётных чисел
    for j in range(len(mass)): #Проходимся по массиву с числами
        if mass[j] % 2 == 0: #Если число чётное, счетчик увеличиваем на 1
            chet += 1
        else:                # #Если число нечётное, другой счетчик увеличиваем на 1
            nechet += 1
    print('чётных элементов:', chet, '\n'
          'нечётных элементов:', nechet)
