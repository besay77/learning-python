
def is_prime(n):
    for j in range(2, int(n ** 0.5) + 1):
        if n % j == 0:
            return False
    return True

def prime_find_div(n):
    massiv = []
    for j in range(2, int(n ** 0.5) + 1):
        if (n % j == 0) and (is_prime(j)==True):
            massiv.append(j)
            if (j != n // j) and (is_prime(n//j)==True):
                massiv.append(n // j)
    massiv.sort()
    return massiv

ans = []
for x in range(100000,500000):
    f = list(set(prime_find_div(x)))
    f.sort()
    if len(f)>3:
        if all(abs(f[i]-f[i+1])==abs(f[i+1]-f[i+2]) and ((f[i+1]-f[i])!=0) for i in range(len(f)-2)):
            ans.append((x,len(f)*(f[1]-f[0])))
print(ans)
